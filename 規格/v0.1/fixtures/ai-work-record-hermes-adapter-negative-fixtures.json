      "case_id": "HERMES_NEG_MAP_TARGET_UNKNOWN",
      "expected": "deny",
      "expected_failure_code": "HERMES_MAP_TARGET_UNKNOWN",
      "covers_hermes_negative_fixture": "a mapping targets something outside the existing skill I/O",
      "run": {
        "hermes_event_map": [
          {"hermes_event": "hermes.task.started", "mapped_to": "start"},
          {"hermes_event": "hermes.task.deploy", "mapped_to": "deploy"}
        ],
        "adapter_adds_fields": [],
        "hermes_required": false,
        "requires_all_users_install": false,
        "supported_hermes_versions": ["1.0", "1.1", "1.2"],
        "hermes_event": "hermes.task.started",
        "mapped_to": "start",
        "adapter_output_ref": "urn:omos:hermes-map:m1",
        "hermes_version": "1.0",
        "outcome": "MAPPED",
        "ok": true
      }
    },
