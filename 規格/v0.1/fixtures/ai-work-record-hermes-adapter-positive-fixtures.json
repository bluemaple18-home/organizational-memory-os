  "hermes_rollback_cases": [
    {
      "case_id": "HERMES_RB_POS_FULL",
      "expected": "allow",
      "rollback": {
        "disable_switch": true,
        "fallback": "CORE_FLOW_DIRECT",
        "side_effects": [
          {"name": "event_subscription", "teardown": "unsubscribe the Adapter from the Hermes event stream", "failure_state": "still subscribed -> the Adapter keeps mapping while disabled"},
          {"name": "version_probe_cache", "teardown": "clear the cached Hermes version probe result", "failure_state": "stale probe -> an incompatible version is treated as compatible on re-enable"},
          {"name": "partial_event_map", "teardown": "discard any half-loaded hermes_event_map", "failure_state": "partial map persisted -> some Hermes events resolve and others do not"}
        ]
      }
    },
    {
      "case_id": "HERMES_RB_POS_MIN",
      "expected": "allow",
      "rollback": {
        "disable_switch": true,
        "fallback": "CORE_FLOW_DIRECT",
        "side_effects": [
          {"name": "event_subscription", "teardown": "unsubscribe from the Hermes event stream", "failure_state": "still subscribed -> Adapter keeps mapping while disabled"}
        ]
      }
    }
  ]
}
