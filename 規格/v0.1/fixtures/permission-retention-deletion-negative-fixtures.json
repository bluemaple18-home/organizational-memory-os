{
  "contract": "urn:omos:contract:permission-retention-deletion:0.1.0",
  "cases": [
    {
      "case_id": "PRD_NEG_UNKNOWN_FROM_STATE",
      "evaluator": "retention",
      "expected": "deny",
      "expected_failure_code": "PRD_UNKNOWN_RETENTION_STATE",
      "covers_negative_fixture": "a from_state that is not a declared retention state",
      "run": { "from_state": "ARCHIVED", "to_state": "RETENTION_EXPIRED" }
    },
    {
      "case_id": "PRD_NEG_UNKNOWN_TO_STATE",
      "evaluator": "retention",
      "expected": "deny",
      "expected_failure_code": "PRD_UNKNOWN_RETENTION_STATE",
      "covers_negative_fixture": "a to_state that is not a declared retention state",
      "run": { "from_state": "RETAINED", "to_state": "SHREDDED" }
    },
    {
      "case_id": "PRD_NEG_ILLEGAL_TRANSITION",
      "evaluator": "retention",
      "expected": "deny",
      "expected_failure_code": "PRD_ILLEGAL_RETENTION_TRANSITION",
      "covers_negative_fixture": "a transition not present in allowed_retention_transitions",
      "run": { "from_state": "RETAINED", "to_state": "TOMBSTONED" }
    },
    {
      "case_id": "PRD_NEG_DEPART_TERMINAL_STATE",
      "evaluator": "retention",
      "expected": "deny",
      "expected_failure_code": "PRD_TERMINAL_STATE_DEPARTURE",
      "covers_negative_fixture": "a departure from a terminal state",
      "run": { "from_state": "PURGED", "to_state": "RETAINED" }
    },
    {
      "case_id": "PRD_NEG_LEGAL_HOLD_BLOCKS_DELETION",
      "evaluator": "retention",
      "expected": "deny",
      "expected_failure_code": "PRD_LEGAL_HOLD_BLOCKS_DELETION",
      "covers_negative_fixture": "a deletion attempted while legal_hold_active",
      "run": {
        "from_state": "RETENTION_EXPIRED",
        "to_state": "TOMBSTONED",
        "legal_hold_active": true,
        "deletion_confirmation_ref": "urn:omos:deletion-confirmation:11111111-2222-3333-4444-555555555555",
        "projection_cleanup_receipt_ref": "urn:omos:projection-cleanup-receipt:aaaa1111-bbbb-2222-cccc-333333333333",
        "preserved_identity_fields": ["evidence_id", "digests", "provenance", "chronology"],
        "inline_payload_present": false
      }
    },
    {
      "case_id": "PRD_NEG_HOLD_RELEASE_MISSING_PRE_STATE",
      "evaluator": "retention",
      "expected": "deny",
      "expected_failure_code": "PRD_HOLD_RELEASE_MISSING_PRE_STATE",
      "covers_negative_fixture": "a hold release without pre_hold_state",
      "run": { "from_state": "LEGAL_HOLD", "to_state": "RETAINED" }
    },
    {
      "case_id": "PRD_NEG_HOLD_RELEASE_RESETS_RETENTION_CLOCK",
      "evaluator": "retention",
      "expected": "deny",
      "expected_failure_code": "PRD_HOLD_RELEASE_STATE_MISMATCH",
      "covers_negative_fixture": "a hold release whose target does not equal pre_hold_state",
      "run": {
        "from_state": "LEGAL_HOLD",
        "to_state": "RETAINED",
        "pre_hold_state": "RETENTION_EXPIRED"
      }
    },
    {
      "case_id": "PRD_NEG_DELETION_WITHOUT_CONFIRMATION",
      "evaluator": "retention",
      "expected": "deny",
      "expected_failure_code": "PRD_MISSING_DELETION_CONFIRMATION",
      "covers_negative_fixture": "a deletion without deletion_confirmation_ref",
      "run": {
        "from_state": "RETENTION_EXPIRED",
        "to_state": "TOMBSTONED",
        "projection_cleanup_receipt_ref": "urn:omos:projection-cleanup-receipt:aaaa1111-bbbb-2222-cccc-333333333333",
        "preserved_identity_fields": ["evidence_id", "digests", "provenance", "chronology"],
        "inline_payload_present": false
      }
    },
    {
      "case_id": "PRD_NEG_DELETION_WITHOUT_CLEANUP_RECEIPT",
      "evaluator": "retention",
      "expected": "deny",
      "expected_failure_code": "PRD_MISSING_CLEANUP_RECEIPT",
      "covers_negative_fixture": "a deletion without projection_cleanup_receipt_ref",
      "run": {
        "from_state": "RETENTION_EXPIRED",
        "to_state": "TOMBSTONED",
        "deletion_confirmation_ref": "urn:omos:deletion-confirmation:11111111-2222-3333-4444-555555555555",
        "preserved_identity_fields": ["evidence_id", "digests", "provenance", "chronology"],
        "inline_payload_present": false
      }
    },
    {
      "case_id": "PRD_NEG_DELETION_DROPS_IDENTITY",
      "evaluator": "retention",
      "expected": "deny",
      "expected_failure_code": "PRD_IDENTITY_NOT_PRESERVED",
      "covers_negative_fixture": "a deletion that does not preserve identity fields",
      "run": {
        "from_state": "RETENTION_EXPIRED",
        "to_state": "TOMBSTONED",
        "deletion_confirmation_ref": "urn:omos:deletion-confirmation:11111111-2222-3333-4444-555555555555",
        "projection_cleanup_receipt_ref": "urn:omos:projection-cleanup-receipt:aaaa1111-bbbb-2222-cccc-333333333333",
        "preserved_identity_fields": ["evidence_id", "digests"],
        "inline_payload_present": false
      }
    },
    {
      "case_id": "PRD_NEG_TOMBSTONE_RETAINS_PAYLOAD",
      "evaluator": "retention",
      "expected": "deny",
      "expected_failure_code": "PRD_TOMBSTONE_RETAINS_PAYLOAD",
      "covers_negative_fixture": "a tombstone that still carries inline payload",
      "run": {
        "from_state": "RETENTION_EXPIRED",
        "to_state": "TOMBSTONED",
        "deletion_confirmation_ref": "urn:omos:deletion-confirmation:11111111-2222-3333-4444-555555555555",
        "projection_cleanup_receipt_ref": "urn:omos:projection-cleanup-receipt:aaaa1111-bbbb-2222-cccc-333333333333",
        "preserved_identity_fields": ["evidence_id", "digests", "provenance", "chronology"],
        "inline_payload_present": true
      }
    },
    {
      "case_id": "PRD_NEG_STALE_DECISION_HONOURED",
      "evaluator": "retrieval",
      "expected": "deny",
      "expected_failure_code": "PRD_STALE_DECISION_HONOURED",
      "covers_negative_fixture": "a retrieval honouring a stale permission decision",
      "run": {
        "permission_decision_ref": "urn:omos:permission-decision:dddd4444-eeee-5555-ffff-666666666666",
        "permission_decision_stale": true,
        "access_granted": true
      }
    },
    {
      "case_id": "PRD_NEG_RETRIEVAL_WITHOUT_DECISION",
      "evaluator": "retrieval",
      "expected": "deny",
      "expected_failure_code": "PRD_MISSING_PERMISSION_DECISION",
      "covers_negative_fixture": "a retrieval without any permission decision",
      "run": {
        "permission_decision_ref": null,
        "permission_decision_stale": false,
        "access_granted": true
      }
    }
  ]
}
